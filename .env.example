# Copy this file to `.env` and fill in the values. `.env` is git-ignored; this file holds names only.
# Docker Compose reads `.env` when it creates the containers, so recreate them after a change.

# --- Model vendor ---
# Required for real triage. Left empty, the service still starts and model calls answer 503 "model-misconfigured".
OPENAI_API_KEY=

# --- Model selection ---
# Any OpenAI model that supports strict tools and structured output on the Responses API.
TRIAGE_MODEL=gpt-4.1-mini
# Sent only when set. Leave empty for non-reasoning models, which reject the parameter.
TRIAGE_REASONING_EFFORT=

# --- Logging ---
# INFO logs one JSON line per event and never message text. DEBUG adds request and tool payloads.
TRIAGE_LOG_LEVEL=INFO

# --- Database ---
# Not read from this file: compose.yaml sets DATABASE_URL for the stack it starts.
# Set it yourself only when running the service outside Docker Compose.
# DATABASE_URL=postgresql://postgres@localhost:5432/triage
