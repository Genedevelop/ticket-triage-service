# --- Secrets ---
# never committed; the example file lists the key names without values
.env
.env.*
!.env.example

# --- Python ---
# bytecode, virtual environments, tool caches and build metadata
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.hypothesis/
*.egg-info/

# --- Local output ---
# results written by evaluation runs
evals/results/
# data files and the HTML report written by coverage measurement
.coverage
.coverage.*
htmlcov/

# --- Operating system ---
.DS_Store
